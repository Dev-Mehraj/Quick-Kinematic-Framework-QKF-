// Window declaration and lifecycle methods test

window MainWindow {
    title: "Quick Kinetic Window";
    width: 800;
    height: 600;

    f doThis() void {
        print("Executing custom window action doThis()");
    }
};

f main() void {
    let window = "MainWindow";
    let name = window;

    name.create();
    name.start();
    name.doThis();
}
